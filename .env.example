# ==============================================================================
# THE LENNY GROWTH ASSISTANT - ENVIRONMENT CONFIGURATION
# OOGWAY LABS - FORWARD DEPLOYED ENGINEERING
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_OLLAMA_ENDPOINT=http://localhost:11434
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI Server)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL
# If PostgreSQL authentication fails or is unconfigured, the server automatically
# falls back to local SQLite storage (sqlite:///./lenny_growth.db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# Local LLM Inference (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Cloud AI Provider Keys (Kept server-side only in backend .env; never in frontend)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
